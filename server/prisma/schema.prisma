generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String
  role           String          @default("BUILDING_ADMIN") // SUPER_ADMIN | BUILDING_ADMIN
  createdAt      DateTime        @default(now())
  buildingAdmins BuildingAdmin[]
  ownedComplexes Complex[]
}

// Join table: which buildings a BUILDING_ADMIN user manages.
// A SUPER_ADMIN bypasses this table entirely and can access every building.
model BuildingAdmin {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, buildingId])
}

model Building {
  id                    Int      @id @default(autoincrement())
  name                  String   @default("הבניין שלי")
  address               String   @default("")
  floors                Int      @default(0)
  apartmentsCount       Int      @default(0)
  monthlyFeeDefault     Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceCash    Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceDigital Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceDate    DateTime @default(now())
  elevatorsCount        Int      @default(0)
  electricityBenchmark  Decimal  @default(0) @db.Decimal(10, 2)
  cleaningBenchmark     Decimal  @default(0) @db.Decimal(10, 2)
  gardeningBenchmark    Decimal  @default(0) @db.Decimal(10, 2)
  isConfigured          Boolean  @default(false)
  inviteCode            String?  @unique // lets a new admin join this specific building without a super-admin; lazily backfilled
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  admins        BuildingAdmin[]
  tenants       Tenant[]
  tasks         Task[]
  expenses      Expense[]
  budgetItems   BudgetItem[]
  complexMember ComplexMember?
}

// A complex (מתחם) groups several buildings that share costs (shared gardening,
// shared parking, etc). Only its owner manages membership, splits and expenses;
// member-building admins can view what's charged to their own building.
model Complex {
  id          Int      @id @default(autoincrement())
  name        String
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  inviteCode  String   @unique
  createdAt   DateTime @default(now())

  members  ComplexMember[]
  expenses ComplexExpense[]
}

// A building's membership in a complex, with an optional custom cost-share.
// When sharePercent is null on every member of a complex, costs split equally;
// when set, they must sum to 100 (enforced by the API, not the database).
model ComplexMember {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  buildingId  Int      @unique // a building belongs to at most one complex
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  sharePercent Decimal? @db.Decimal(5, 2)
  joinedAt    DateTime @default(now())

  @@unique([complexId, buildingId])
}

// A shared complex-level cost (gardening, shared parking maintenance...). Creating
// one fans out a proportional Expense row into every member building so each
// building's own deterministic balance calculation picks it up automatically.
model ComplexExpense {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  paidFrom    String // CASH | DIGITAL
  createdAt   DateTime @default(now())

  buildingExpenses Expense[]
}

model Tenant {
  id              Int      @id @default(autoincrement())
  buildingId      Int
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor           Int
  apartmentNumber String
  name            String
  phone           String?
  role            String   @default("OWNER") // OWNER | RENTER
  monthlyFee      Decimal? @db.Decimal(10, 2) // overrides building default when set
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  dues            Due[]
}

model Due {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year             Int
  month            Int // 1-12
  amountDue        Decimal   @db.Decimal(10, 2)
  status           String    @default("UNPAID") // UNPAID | PAID_BANK | PAID_CASH | PENDING_CASH_APPROVAL
  paidDate         DateTime?
  reportedByTenant Boolean   @default(false)
  approvedAt       DateTime?
  note             String?
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, year, month])
}

model Task {
  id              Int       @id @default(autoincrement())
  buildingId      Int
  building        Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  location        String?
  urgency         String    @default("רגיל") // רגיל | דחוף
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | CONTRACTOR | RESOLVED
  attachmentUrl   String?
  isRecurring     Boolean   @default(false)
  recurrenceLabel String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
}

model Expense {
  id               Int             @id @default(autoincrement())
  buildingId       Int
  building         Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  date             DateTime
  category         String
  description      String?
  supplierName     String?
  amount           Decimal         @db.Decimal(10, 2)
  paidFrom         String // CASH | DIGITAL
  receiptUrl       String?
  createdAt        DateTime        @default(now())
  complexExpenseId Int? // set when this row was auto-generated from a shared ComplexExpense
  complexExpense   ComplexExpense? @relation(fields: [complexExpenseId], references: [id], onDelete: Cascade)
}

model BudgetItem {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category   String
  label      String
  frequency  String // MONTHLY | BIMONTHLY | SEMIANNUAL | ANNUAL
  amount     Decimal  @db.Decimal(10, 2)
  months     Int[] // months (1-12) this line applies to
}
