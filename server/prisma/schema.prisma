generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String?
  role           String          @default("BUILDING_ADMIN") // SUPER_ADMIN | BUILDING_ADMIN
  marketingConsent Boolean       @default(false) // optional for building admins, unlike Professional where it's required
  createdAt      DateTime        @default(now())
  buildingAdmins BuildingAdmin[]
  ownedComplexes Complex[]
  suggestions    Suggestion[]
}

// A tradesperson/contractor who registered interest in offering services through the
// platform. No login account - just a lead, browsable by building admins as a directory.
// Track/plan selection (מסלולים) and any paywall are deliberately not modeled yet.
model Professional {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String
  email            String
  profession       String
  message          String?
  marketingConsent Boolean  @default(false) // required at signup - push about open jobs/deals/contractor collabs
  createdAt        DateTime @default(now())
}

// Single-row site-wide configuration (not per-building). Always id 1.
model AppSettings {
  id                    Int     @id @default(1)
  showBuildingCountStat Boolean @default(true)
}

// A free-text improvement suggestion, submittable from anywhere in the app. Reviewed
// only by the super-admin, who tracks its status and can leave a private note.
model Suggestion {
  id         Int       @id @default(autoincrement())
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  text       String
  status     String    @default("NEW") // NEW | IN_PROGRESS | DONE | REJECTED
  adminNotes String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Join table: which buildings a BUILDING_ADMIN user manages, and with what access.
// A SUPER_ADMIN bypasses this table entirely and can access every building.
model BuildingAdmin {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role       String   @default("ADMIN") // ADMIN (full edit) | VIEWER (read-only) - meaningless while PENDING
  status     String   @default("ACTIVE") // ACTIVE | PENDING (self-service invite-code joins wait for an admin to approve)
  createdAt  DateTime @default(now())

  @@unique([userId, buildingId])
}

model Building {
  id                    Int      @id @default(autoincrement())
  name                  String   @default("הבניין שלי")
  address               String   @default("")
  floors                Int      @default(0)
  apartmentsCount       Int      @default(0)
  monthlyFeeDefault     Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceCash    Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceBank    Decimal  @default(0) @db.Decimal(10, 2)
  openingBalancePaybox  Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceDate    DateTime @default(now())
  elevatorsCount        Int      @default(0)
  electricityBenchmark  Decimal  @default(0) @db.Decimal(10, 2)
  cleaningBenchmark     Decimal  @default(0) @db.Decimal(10, 2)
  gardeningBenchmark    Decimal  @default(0) @db.Decimal(10, 2)
  isConfigured          Boolean  @default(false)
  inviteCode            String?  @unique // lets a new admin join this specific building without a super-admin; lazily backfilled
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  admins          BuildingAdmin[]
  tenants         Tenant[]
  tasks           Task[]
  expenses        Expense[]
  budgetItems     BudgetItem[]
  complexMember   ComplexMember?
  meetingMinutes  MeetingMinutes[]
  procedures      Procedure[]
  announcements   Announcement[]
  suggestions     Suggestion[]
  electricityDebts ComplexElectricityDebt[]
}

model MeetingMinutes {
  id            Int      @id @default(autoincrement())
  buildingId    Int
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  content       String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

model Procedure {
  id            Int      @id @default(autoincrement())
  buildingId    Int
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title         String
  content       String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  createdAt  DateTime @default(now())
}

// A complex (מתחם) groups several buildings that share costs (shared gardening,
// shared parking, etc). Only its owner manages membership, splits and expenses;
// member-building admins can view what's charged to their own building.
model Complex {
  id                     Int      @id @default(autoincrement())
  name                   String
  ownerId                Int
  owner                  User     @relation(fields: [ownerId], references: [id])
  inviteCode             String   @unique
  electricityRatePerUnit Decimal? @db.Decimal(10, 4) // ₪ per meter unit, set once by the owner
  lastElectricityReading Decimal? @db.Decimal(12, 2) // baseline for the next reading's consumption
  createdAt              DateTime @default(now())

  members             ComplexMember[]
  expenses             ComplexExpense[]
  electricityReadings  ComplexElectricityReading[]
}

// A building's membership in a complex, with an optional custom cost-share.
// When sharePercent is null on every member of a complex, costs split equally;
// when set, they must sum to 100 (enforced by the API, not the database).
model ComplexMember {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  buildingId  Int      @unique // a building belongs to at most one complex
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  sharePercent Decimal? @db.Decimal(5, 2)
  joinedAt    DateTime @default(now())

  @@unique([complexId, buildingId])
}

// A shared complex-level cost (gardening, shared parking maintenance...). Creating
// one fans out a proportional Expense row into every member building so each
// building's own deterministic balance calculation picks it up automatically.
model ComplexExpense {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  paidFrom    String // CASH | BANK | PAYBOX
  createdAt   DateTime @default(now())

  buildingExpenses Expense[]
}

// A shared electricity meter reading for the complex. Consumption since the previous
// reading is costed at the complex's per-unit rate and split into a per-building debt -
// a standalone ledger deliberately kept separate from each building's own treasury
// (no Expense rows created) until that specific building's debt is marked paid.
model ComplexElectricityReading {
  id              Int      @id @default(autoincrement())
  complexId       Int
  complex         Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  readingDate     DateTime
  previousReading Decimal  @db.Decimal(12, 2)
  currentReading  Decimal  @db.Decimal(12, 2)
  consumption     Decimal  @db.Decimal(12, 2)
  ratePerUnit     Decimal  @db.Decimal(10, 4)
  totalCost       Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  debts ComplexElectricityDebt[]
}

model ComplexElectricityDebt {
  id         Int                        @id @default(autoincrement())
  readingId  Int
  reading    ComplexElectricityReading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building                   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  amountOwed Decimal                    @db.Decimal(10, 2)
  paid       Boolean                    @default(false)
  paidAt     DateTime?
}

model Tenant {
  id              Int      @id @default(autoincrement())
  buildingId      Int
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor           Int
  apartmentNumber String
  name            String
  phone           String?
  role            String   @default("OWNER") // OWNER | RENTER
  monthlyFee      Decimal? @db.Decimal(10, 2) // overrides building default when set
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) // manual display order, independent of apartmentNumber text
  createdAt       DateTime @default(now())
  dues            Due[]
}

model Due {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year             Int
  month            Int // 1-12
  amountDue        Decimal   @db.Decimal(10, 2)
  status           String    @default("UNPAID") // UNPAID | PAID_BANK | PAID_PAYBOX | PAID_CASH | PENDING_CASH_APPROVAL
  paidDate         DateTime?
  reportedByTenant Boolean   @default(false)
  approvedAt       DateTime?
  note             String?
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, year, month])
}

model Task {
  id              Int       @id @default(autoincrement())
  buildingId      Int
  building        Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  location        String?
  urgency         String    @default("רגיל") // רגיל | דחוף
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | CONTRACTOR | RESOLVED
  attachmentUrl   String?
  isRecurring     Boolean   @default(false)
  recurrenceLabel String?
  cost            Decimal?  @db.Decimal(10, 2) // informational - not auto-posted to the expense ledger
  paidFrom        String? // CASH | BANK | PAYBOX, only meaningful when cost is set
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
}

model Expense {
  id               Int             @id @default(autoincrement())
  buildingId       Int
  building         Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  date             DateTime
  category         String
  description      String?
  supplierName     String?
  amount           Decimal         @db.Decimal(10, 2)
  paidFrom         String // CASH | BANK | PAYBOX
  receiptUrl       String? // external link, kept as an alternative to an uploaded file
  receiptFileName  String?
  receiptMimeType  String?
  receiptData      Bytes?
  createdAt        DateTime        @default(now())
  complexExpenseId Int? // set when this row was auto-generated from a shared ComplexExpense
  complexExpense   ComplexExpense? @relation(fields: [complexExpenseId], references: [id], onDelete: Cascade)
}

model BudgetItem {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category   String
  label      String
  frequency  String // MONTHLY | BIMONTHLY | SEMIANNUAL | ANNUAL
  amount     Decimal  @db.Decimal(10, 2)
  months     Int[] // months (1-12) this line applies to
}
