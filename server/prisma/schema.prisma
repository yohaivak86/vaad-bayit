generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String
  phone          String?
  role           String          @default("BUILDING_ADMIN") // SUPER_ADMIN (site admin) | anything else = regular user; per-building access lives in BuildingAdmin.role
  marketingConsent Boolean       @default(false) // optional for building admins, unlike Professional where it's required
  createdAt      DateTime        @default(now())
  buildingAdmins BuildingAdmin[]
  ownedComplexes Complex[]
  suggestions    Suggestion[]
  tenantLinks    Tenant[]
  passwordResets PasswordReset[]
  complexJoinRequests ComplexJoinRequest[]
  reportedTasks  Task[]          @relation("TaskReporter")
  apartmentLinks ApartmentResident[]
}

// One-time password-reset token, e-mailed to the user. Only the SHA-256 hash is stored.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// A tradesperson/contractor who registered interest in offering services through the
// platform. No login account - just a lead, browsable by building admins as a directory.
// Track/plan selection (מסלולים) and any paywall are deliberately not modeled yet.
model Professional {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String
  email            String
  profession       String
  message          String?
  marketingConsent Boolean  @default(false) // required at signup - push about open jobs/deals/contractor collabs
  createdAt        DateTime @default(now())
}

// Single-row site-wide configuration (not per-building). Always id 1.
model AppSettings {
  id                    Int     @id @default(1)
  showBuildingCountStat Boolean @default(true)
}

// A free-text improvement suggestion, submittable from anywhere in the app. Reviewed
// only by the super-admin, who tracks its status and can leave a private note.
model Suggestion {
  id         Int       @id @default(autoincrement())
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  text       String
  status     String    @default("NEW") // NEW | IN_PROGRESS | DONE | REJECTED
  adminNotes String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// Join table: a user's role inside one building (RESIDENT or COMMITTEE).
// A SUPER_ADMIN (site admin) bypasses this table entirely and can access every building.
model BuildingAdmin {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role       String   @default("RESIDENT") // RESIDENT (default, sees only their own data) | COMMITTEE (נציג ועד, manages the building) - meaningless while PENDING
  status     String   @default("ACTIVE") // ACTIVE | PENDING (self-service invite-code joins wait for an admin to approve)
  createdAt  DateTime @default(now())

  @@unique([userId, buildingId])
}

model Building {
  id                    Int      @id @default(autoincrement())
  name                  String   @default("הבניין שלי")
  address               String   @default("")
  floors                Int      @default(0)
  apartmentsCount       Int      @default(0)
  monthlyFeeDefault     Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceCash    Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceBank    Decimal  @default(0) @db.Decimal(10, 2)
  openingBalancePaybox  Decimal  @default(0) @db.Decimal(10, 2)
  openingBalanceDate    DateTime @default(now())
  elevatorsCount        Int      @default(0)
  electricityBenchmark  Decimal  @default(0) @db.Decimal(10, 2)
  cleaningBenchmark     Decimal  @default(0) @db.Decimal(10, 2)
  gardeningBenchmark    Decimal  @default(0) @db.Decimal(10, 2)
  isConfigured          Boolean  @default(false)
  treasuryRedLine       Decimal  @default(10000) @db.Decimal(10, 2) // the combined treasury must stay above this (reserve for unplanned work)
  inviteCode            String?  @unique // lets a new admin join this specific building without a super-admin; lazily backfilled
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  admins          BuildingAdmin[]
  tenants         Tenant[]
  tasks           Task[]
  expenses        Expense[]
  budgetItems     BudgetItem[]
  complexMember   ComplexMember?
  meetingMinutes  MeetingMinutes[]
  procedures      Procedure[]
  announcements   Announcement[]
  suggestions     Suggestion[]
  electricityDebts ComplexElectricityDebt[]
  providers       ServiceProvider[]
  providerLinks   ServiceProviderLink[]
  recurringItems  RecurringItem[]
  polls           Poll[]
  complexJoinRequests ComplexJoinRequest[]
}

// An expected recurring (or one-time) cost / chore the committee plans ahead: elevator service,
// annual fire-extinguisher check, insurance... Feeds the "next month" list on the dashboard and
// can be linked from tasks and expenses.
model RecurringItem {
  id             Int       @id @default(autoincrement())
  buildingId     Int
  building       Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title          String
  category       String    @default("אחר")
  frequency      String // MONTHLY | ANNUAL | ONE_TIME
  month          Int? // 1-12, for ANNUAL
  dueDate        DateTime? // for ONE_TIME
  expectedAmount Decimal?  @db.Decimal(10, 2)
  notes          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  tasks          Task[]
  expenses       Expense[]
}

// A building asking to join a complex (found by number / name / address). The complex owner -
// who must be a committee rep - approves or rejects it.
model ComplexJoinRequest {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  buildingId  Int
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  requestedById Int
  requestedBy User     @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())

  @@unique([complexId, buildingId])
}

model MeetingMinutes {
  id            Int      @id @default(autoincrement())
  buildingId    Int
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title         String
  date          DateTime
  content       String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

model Procedure {
  id            Int      @id @default(autoincrement())
  buildingId    Int
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title         String
  content       String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title      String
  body       String?
  createdAt  DateTime @default(now())
}

// A complex (מתחם) groups several buildings that share costs (shared gardening,
// shared parking, etc). Only its owner manages membership, splits and expenses;
// member-building admins can view what's charged to their own building.
model Complex {
  id                     Int      @id @default(autoincrement())
  number                 Int      @unique @default(autoincrement()) // public, searchable complex number
  name                   String
  address                String   @default("")
  ownerId                Int
  owner                  User     @relation(fields: [ownerId], references: [id])
  inviteCode             String   @unique
  electricityRatePerUnit Decimal? @db.Decimal(10, 4) // ₪ per meter unit, set once by the owner
  lastElectricityReading Decimal? @db.Decimal(12, 2) // baseline for the next reading's consumption
  createdAt              DateTime @default(now())

  members             ComplexMember[]
  expenses             ComplexExpense[]
  electricityReadings  ComplexElectricityReading[]
  tasks                Task[]
  providers            ServiceProvider[]
  joinRequests         ComplexJoinRequest[]
}

// A building's membership in a complex, with an optional custom cost-share.
// When sharePercent is null on every member of a complex, costs split equally;
// when set, they must sum to 100 (enforced by the API, not the database).
model ComplexMember {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  buildingId  Int      @unique // a building belongs to at most one complex
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  sharePercent Decimal? @db.Decimal(5, 2)
  joinedAt    DateTime @default(now())

  @@unique([complexId, buildingId])
}

// A shared complex-level cost (gardening, shared parking maintenance...). Creating
// one fans out a proportional Expense row into every member building so each
// building's own deterministic balance calculation picks it up automatically.
model ComplexExpense {
  id          Int      @id @default(autoincrement())
  complexId   Int
  complex     Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  paidFrom    String // CASH | BANK | PAYBOX
  createdAt   DateTime @default(now())

  buildingExpenses Expense[]
}

// A shared electricity meter reading for the complex. Consumption since the previous
// reading is costed at the complex's per-unit rate and split into a per-building debt -
// a standalone ledger deliberately kept separate from each building's own treasury
// (no Expense rows created) until that specific building's debt is marked paid.
model ComplexElectricityReading {
  id              Int      @id @default(autoincrement())
  complexId       Int
  complex         Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  readingDate     DateTime
  previousReading Decimal  @db.Decimal(12, 2)
  currentReading  Decimal  @db.Decimal(12, 2)
  consumption     Decimal  @db.Decimal(12, 2)
  ratePerUnit     Decimal  @db.Decimal(10, 4)
  totalCost       Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  debts ComplexElectricityDebt[]
}

model ComplexElectricityDebt {
  id         Int                        @id @default(autoincrement())
  readingId  Int
  reading    ComplexElectricityReading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building                   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  amountOwed Decimal                    @db.Decimal(10, 2)
  paid       Boolean                    @default(false)
  paidAt     DateTime?
}

model Tenant {
  id              Int      @id @default(autoincrement())
  buildingId      Int
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor           Int
  apartmentNumber String
  name            String
  phone           String?
  role            String   @default("OWNER") // OWNER | RENTER
  monthlyFee      Decimal? @db.Decimal(10, 2) // overrides building default when set
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) // manual display order, independent of apartmentNumber text
  userId          Int? // the resident account linked to this apartment (lets them see/edit only their own details)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  dues            Due[]
  residents       ApartmentResident[]

  @@unique([buildingId, userId])
}

model Due {
  id               Int       @id @default(autoincrement())
  tenantId         Int
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year             Int
  month            Int // 1-12
  amountDue        Decimal   @db.Decimal(10, 2)
  status           String    @default("UNPAID") // UNPAID | PAID_BANK | PAID_PAYBOX | PAID_CASH | PENDING_CASH_APPROVAL
  paidDate         DateTime?
  reportedByTenant Boolean   @default(false)
  approvedAt       DateTime?
  note             String?
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, year, month])
}

// A task belongs to exactly one scope: a single building (buildingId) or a whole complex
// (complexId) - complex tasks show up on every member building's timeline.
model Task {
  id              Int       @id @default(autoincrement())
  buildingId      Int?
  building        Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  complexId       Int?
  complex         Complex?  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  dueDate         DateTime?
  showOnTimeline  Boolean   @default(true)
  title           String
  description     String?
  location        String?
  urgency         String    @default("רגיל") // רגיל | דחוף
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | CONTRACTOR | RESOLVED
  attachmentUrl   String?
  isRecurring     Boolean   @default(false)
  recurrenceLabel String?
  cost            Decimal?  @db.Decimal(10, 2) // setting a cost posts a matching Expense (Expense.taskId)
  paidFrom        String? // CASH | BANK | PAYBOX, only meaningful when cost is set
  recurringItemId Int?
  recurringItem   RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  residentReported Boolean  @default(false) // "תקלת דייר" - opened by a resident
  reportedById    Int?
  reportedBy      User?     @relation("TaskReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  contractorName  String?
  contractorPhone String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  resolvedAt      DateTime?
}

model Expense {
  id               Int             @id @default(autoincrement())
  buildingId       Int
  building         Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  date             DateTime
  category         String
  description      String?
  supplierName     String?
  amount           Decimal         @db.Decimal(10, 2)
  paidFrom         String // CASH | BANK | PAYBOX
  receiptUrl       String? // external link, kept as an alternative to an uploaded file
  receiptFileName  String?
  receiptMimeType  String?
  receiptData      Bytes?
  showOnTimeline   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  complexExpenseId Int? // set when this row was auto-generated from a shared ComplexExpense
  complexExpense   ComplexExpense? @relation(fields: [complexExpenseId], references: [id], onDelete: Cascade)
  taskId           Int? // set when this row was auto-posted from a task's cost
  recurringItemId  Int?
  recurringItem    RecurringItem?  @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
}

model BudgetItem {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  category   String
  label      String
  frequency  String // MONTHLY | BIMONTHLY | SEMIANNUAL | ANNUAL
  amount     Decimal  @db.Decimal(10, 2)
  months     Int[] // months (1-12) this line applies to
}

// A service provider (cleaner, elevator technician, gardener...) of a single building or
// of a whole complex. Complex providers can be linked to a subset of the member buildings.
model ServiceProvider {
  id         Int       @id @default(autoincrement())
  name       String
  category   String
  phone      String?
  email      String?
  notes      String?
  buildingId Int?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  complexId  Int?
  complex    Complex?  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  links ServiceProviderLink[]
}

model ServiceProviderLink {
  id         Int             @id @default(autoincrement())
  providerId Int
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  buildingId Int
  building   Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([providerId, buildingId])
}

// Additional residents of the same apartment (the first one is Tenant.userId). Lets a whole household
// have accounts - while a poll still counts one vote per apartment.
model ApartmentResident {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId Int
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([buildingId, userId])
}

// A building vote. One vote per APARTMENT (Vote.apartmentNumber), no matter how many residents it has.
model Poll {
  id          Int       @id @default(autoincrement())
  buildingId  Int
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  title       String
  description String?
  options     String[]
  status      String    @default("OPEN") // OPEN | CLOSED
  closesAt    DateTime?
  createdById Int?
  createdAt   DateTime  @default(now())

  votes Vote[]
  logs  VoteLog[]
}

model Vote {
  id              Int      @id @default(autoincrement())
  pollId          Int
  poll            Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  apartmentNumber String
  optionIndex     Int
  castById        Int
  castByName      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pollId, apartmentNumber])
}

// Every CHANGE of an existing vote (by the same or another resident of the apartment) - committee only.
model VoteLog {
  id                Int      @id @default(autoincrement())
  pollId            Int
  poll              Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  apartmentNumber   String
  changedById       Int
  changedByName     String
  previousVoterName String
  previousOption    Int
  newOption         Int
  createdAt         DateTime @default(now())
}
